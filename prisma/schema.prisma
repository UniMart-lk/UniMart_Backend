// Prisma Schema for UniMart System
// Based on UniMart Software Requirements Specification (SRS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  USER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  STUDENT
  EXTERNAL
}

enum ProviderType {
  STUDENT_PROVIDER
  EXTERNAL_PROVIDER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CategoryType {
  MARKETPLACE
  RENTAL
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ProductStatus {
  AVAILABLE
  SOLD
  DEACTIVATED
}

enum RentalPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum RentalItemType {
  VEHICLE
  EQUIPMENT
  OTHER
}

enum RentalListingStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

enum AssetStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  THREE_WHEELER
  BICYCLE
}

enum EquipmentType {
  CAMPING
  SPORTS
  EVENT
  ACADEMIC
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TransactionType {
  MARKETPLACE
  RENTAL
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportEntityType {
  USER
  PROVIDER
  MARKETPLACE_LISTING
  RENTAL_LISTING
  MESSAGE
  REVIEW
}

enum ReportReason {
  FRAUD
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_UPDATE
  NEW_MESSAGE
  VERIFICATION_UPDATE
  SYSTEM
}

// --------------------------------------------------------
// CORE USERS & PROFILES
// --------------------------------------------------------

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(191)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  contactNumber String?    @map("contact_number") @db.VarChar(50)
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relationships
  userProfile          UserProfile?
  providerProfile      ProviderProfile?
  bookings             RentalBooking[]
  reviews              Review[]
  sentMessages         Message[]        @relation("SentMessages")
  receivedMessages     Message[]        @relation("ReceivedMessages")
  conversationsAsUser1 Conversation[]   @relation("ParticipantOne")
  conversationsAsUser2 Conversation[]   @relation("ParticipantTwo")
  filedReports         Report[]         @relation("ReportedBy")
  reportsAgainst       Report[]         @relation("ReportedUser")
  resolvedReports      Report[]         @relation("AdminResolved")
  notifications        Notification[]

  @@index([email])
  @@index([role, status])
  @@map("users")
}

model UserProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  fullName          String    @map("full_name") @db.VarChar(150)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  contactNumber     String?   @map("contact_number") @db.VarChar(50)
  profilePictureUrl String?   @map("profile_picture_url") @db.VarChar(500)
  userType          UserType? @map("user_type")

  // Student Specific Fields
  university         String? @db.VarChar(150)
  faculty            String? @db.VarChar(150)
  universityEmail    String? @map("university_email") @db.VarChar(191)
  universityIdNumber String? @map("university_id_number") @db.VarChar(100)

  // External Specific Fields
  nicNumber String? @map("nic_number") @db.VarChar(100)

  isCompleted     Boolean  @default(false) @map("is_completed")
  privacySettings Json?    @map("privacy_settings")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userType])
  @@map("user_profiles")
}

model ProviderProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique @map("user_id")
  providerType       ProviderType       @map("provider_type")
  displayName        String             @map("display_name") @db.VarChar(150)
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationDocUrl String?            @map("verification_doc_url") @db.VarChar(500)
  rejectionReason    String?            @map("rejection_reason") @db.Text
  overallRating      Decimal            @default(0.00) @map("overall_rating") @db.Decimal(3, 2)
  totalReviews       Int                @default(0) @map("total_reviews")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relationships
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceProducts MarketplaceProduct[]
  rentalListings      RentalListing[]
  reviewsReceived     Review[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([providerType])
  @@map("provider_profiles")
}

// --------------------------------------------------------
// CATEGORIES
// --------------------------------------------------------

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(120)
  type        CategoryType
  description String?      @db.VarChar(255)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relationships
  marketplaceProducts MarketplaceProduct[]
  rentalListings      RentalListing[]

  @@index([type, isActive])
  @@map("categories")
}

// --------------------------------------------------------
// SECOND-HAND MARKETPLACE
// --------------------------------------------------------

model MarketplaceProduct {
  id          Int              @id @default(autoincrement())
  providerId  Int              @map("provider_id")
  categoryId  Int              @map("category_id")
  title       String           @db.VarChar(200)
  description String           @db.Text
  condition   ProductCondition
  price       Decimal          @db.Decimal(10, 2)
  location    String           @db.VarChar(200)
  status      ProductStatus    @default(AVAILABLE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relationships
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@map("marketplace_products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// --------------------------------------------------------
// RENTAL MARKETPLACE & ASSETS
// --------------------------------------------------------

model RentalListing {
  id           Int                 @id @default(autoincrement())
  providerId   Int                 @map("provider_id")
  categoryId   Int                 @map("category_id")
  title        String              @db.VarChar(200)
  description  String              @db.Text
  condition    String              @db.VarChar(100)
  rentalPrice  Decimal             @map("rental_price") @db.Decimal(10, 2)
  rentalPeriod RentalPeriod        @default(DAILY) @map("rental_period")
  itemType     RentalItemType      @map("item_type")
  status       RentalListingStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relationships
  provider        ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          RentalListingImage[]
  assets          RentalAsset[]
  vehicleDetail   RentalVehicleDetail?
  equipmentDetail RentalEquipmentDetail?
  bookings        RentalBooking[]

  @@index([providerId])
  @@index([categoryId])
  @@index([itemType, status])
  @@index([rentalPrice])
  @@map("rental_listings")
}

model RentalListingImage {
  id              Int      @id @default(autoincrement())
  rentalListingId Int      @map("rental_listing_id")
  imageUrl        String   @map("image_url") @db.VarChar(500)
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relationships
  rentalListing RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@index([rentalListingId])
  @@map("rental_listing_images")
}

model RentalAsset {
  id              Int         @id @default(autoincrement())
  rentalListingId Int         @map("rental_listing_id")
  assetIdentifier String      @map("asset_identifier") @db.VarChar(100)
  status          AssetStatus @default(AVAILABLE)
  notes           String?     @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at")

  // Relationships
  rentalListing RentalListing   @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
  bookings      RentalBooking[]

  @@index([rentalListingId])
  @@index([status])
  @@map("rental_assets")
}

model RentalVehicleDetail {
  id                 Int         @id @default(autoincrement())
  rentalListingId    Int         @unique @map("rental_listing_id")
  vehicleType        VehicleType @map("vehicle_type")
  makeModel          String      @map("make_model") @db.VarChar(150)
  specifications     String?     @db.Text
  pickupLocationName String      @map("pickup_location_name") @db.VarChar(255)
  latitude           Decimal     @db.Decimal(10, 7)
  longitude          Decimal     @db.Decimal(10, 7)

  // Relationships
  rentalListing RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@index([rentalListingId])
  @@index([vehicleType])
  @@map("rental_vehicle_details")
}

model RentalEquipmentDetail {
  id                 Int           @id @default(autoincrement())
  rentalListingId    Int           @unique @map("rental_listing_id")
  equipmentType      EquipmentType @map("equipment_type")
  specifications     String?       @db.Text
  pickupLocationName String        @map("pickup_location_name") @db.VarChar(255)

  // Relationships
  rentalListing RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@index([rentalListingId])
  @@index([equipmentType])
  @@map("rental_equipment_details")
}

// --------------------------------------------------------
// BOOKINGS & RESERVATIONS
// --------------------------------------------------------

model RentalBooking {
  id                 Int           @id @default(autoincrement())
  bookingNumber      String        @unique @map("booking_number") @db.VarChar(50)
  userId             Int           @map("user_id")
  rentalListingId    Int           @map("rental_listing_id")
  rentalAssetId      Int?          @map("rental_asset_id")
  startDate          DateTime      @map("start_date")
  endDate            DateTime      @map("end_date")
  totalPrice         Decimal       @map("total_price") @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  cancellationReason String?       @map("cancellation_reason") @db.Text
  userDetailsPdfUrl  String?       @map("user_details_pdf_url") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relationships
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  rentalListing RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Restrict)
  rentalAsset   RentalAsset?  @relation(fields: [rentalAssetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rentalListingId])
  @@index([rentalAssetId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("rental_bookings")
}

// --------------------------------------------------------
// REAL-TIME MESSAGING (Socket.io)
// --------------------------------------------------------

model Conversation {
  id               Int           @id @default(autoincrement())
  participantOneId Int           @map("participant_one_id")
  participantTwoId Int           @map("participant_two_id")
  itemType         CategoryType? @map("item_type")
  itemId           Int?          @map("item_id")
  lastMessageAt    DateTime      @default(now()) @map("last_message_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  // Relationships
  participantOne User      @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo User      @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participantOneId, participantTwoId, itemType, itemId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  receiverId     Int       @map("receiver_id")
  messageContent String    @map("message_content") @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relationships
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}

// --------------------------------------------------------
// RATINGS & REVIEWS
// --------------------------------------------------------

model Review {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  providerId      Int             @map("provider_id")
  transactionType TransactionType @map("transaction_type")
  transactionId   Int             @map("transaction_id")
  rating          Int             @db.TinyInt
  comment         String?         @db.Text
  status          ReviewStatus    @default(PUBLISHED)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relationships
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionType, transactionId])
  @@index([providerId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// --------------------------------------------------------
// REPORTS & SAFETY MODERATION
// --------------------------------------------------------

model Report {
  id                Int              @id @default(autoincrement())
  reporterId        Int              @map("reporter_id")
  reportedUserId    Int?             @map("reported_user_id")
  entityType        ReportEntityType @map("entity_type")
  entityId          Int              @map("entity_id")
  reasonType        ReportReason     @map("reason_type")
  description       String           @db.Text
  status            ReportStatus     @default(PENDING)
  adminNotes        String?          @map("admin_notes") @db.Text
  resolvedByAdminId Int?             @map("resolved_by_admin_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  resolvedAt        DateTime?        @map("resolved_at")

  // Relationships
  reporter        User  @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedByAdmin User? @relation("AdminResolved", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([entityType, entityId])
  @@map("reports")
}

// --------------------------------------------------------
// NOTIFICATIONS (FCM & In-App)
// --------------------------------------------------------

model Notification {
  id            Int              @id @default(autoincrement())
  recipientId   Int              @map("recipient_id")
  type          NotificationType
  title         String           @db.VarChar(200)
  content       String           @db.Text
  referenceType String?          @map("reference_type") @db.VarChar(100)
  referenceId   Int?             @map("reference_id")
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relationships
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}
